# Django core (DJANGO_SECRET_KEY must be unique and private in each environment)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_NAME=shivanyams_portal
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Server-to-server Shivanya Auth identity lookup
AUTH_ME_URL=http://127.0.0.1:8000/api/v1/auth/me/
AUTH_REQUEST_TIMEOUT=4
AUTH_ACCESS_COOKIE_NAME=shivanya_access

# Browser origins allowed to call the Portal API
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Optional SMTP settings (leave blank to use Django's configured default backend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
