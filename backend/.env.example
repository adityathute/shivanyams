# Django core. Use a unique, private secret per environment.
# Keep DEBUG=False and set explicit public hosts in production.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_NAME=shivanyams_portal
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Server-to-server Shivanya Auth identity lookup.
# This URL must be reachable from the Portal backend, not the browser.
AUTH_ME_URL=http://127.0.0.1:8000/api/v1/auth/me/
AUTH_REQUEST_TIMEOUT=4
AUTH_ACCESS_COOKIE_NAME=shivanya_access

# Browser origins allowed to call the Portal API.
# Include scheme and host; use comma-separated values for multiple origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Optional SMTP settings for post-update subscriber notifications.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
